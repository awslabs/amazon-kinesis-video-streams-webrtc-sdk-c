diff --git a/usrsctplib/user_socket.c b/usrsctplib/user_socket.c
index 163db34..acd6b33 100755
--- a/usrsctplib/user_socket.c
+++ b/usrsctplib/user_socket.c
@@ -1983,6 +1983,28 @@ int userspace_connect(struct socket *so, struct sockaddr *name, int namelen)
 	return (usrsctp_connect(so, name, namelen));
 }
 
+int
+usrsctp_snap_prepare(struct socket *so, struct sockaddr *name, socklen_t namelen, void *init, size_t *init_len)
+{
+	struct sockaddr *sa = NULL;
+
+	if ((so == NULL) || (name == NULL) || (init == NULL) || (init_len == NULL)) {
+		errno = EINVAL;
+		return (-1);
+	}
+	errno = getsockaddr(&sa, (caddr_t)name, namelen);
+	if (errno) {
+		return (-1);
+	}
+	if (sa->sa_family != AF_CONN) {
+		errno = EAFNOSUPPORT;
+	} else {
+		errno = sctpconn_snap_prepare(so, sa, init, init_len);
+	}
+	FREE(sa, M_SONAME);
+	return (errno ? -1 : 0);
+}
+
